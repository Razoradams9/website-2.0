# ─────────────────────────────────────────────
#  CBSE School Portal — Environment Variables
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SCHOOL_NAME="Your School Name"
NEXT_PUBLIC_SCHOOL_TAGLINE="Excellence in Education"
NEXT_PUBLIC_SCHOOL_ADDRESS="123 School Road, City, State - 000000"
NEXT_PUBLIC_SCHOOL_PHONE="+91-XXXXXXXXXX"
NEXT_PUBLIC_SCHOOL_EMAIL="info@yourschool.edu.in"
NEXT_PUBLIC_SCHOOL_AFFILIATION_NO="XXXXXXXXX"
NEXT_PUBLIC_SCHOOL_CODE="XXXXX"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
NEXT_PUBLIC_WHATSAPP_NUMBER="+91XXXXXXXXXX"

# ── Database ─────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/school_db?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/school_db?schema=public"

# ── NextAuth ─────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_super_secret_key_min_32_chars_long_here

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Cloudinary ───────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=school_uploads

# ── AWS S3 (alternative to Cloudinary) ───────
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-school-bucket

# ── UploadThing ───────────────────────────────
UPLOADTHING_SECRET=sk_live_xxxxxxxxxxxxxxxxxxxx
UPLOADTHING_APP_ID=xxxxxxxxxxxxxxxxxxxx

# ── Email (SMTP) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="Your School Name"
SMTP_FROM_EMAIL=noreply@yourschool.edu.in

# ── Rate Limiting ─────────────────────────────
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ── Payment Gateway (optional) ───────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
